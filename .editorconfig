root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
# CUSTOM 1: 140 columns instead of ktlint's default (off for ktlint_official, 140 only for android-style). Kept in sync with
# detekt's MaxLineLength.
max_line_length = 140
# CUSTOM 2: trailing commas are allowed (not mandated) at declaration and call sites.
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# CUSTOM 3: disable two opinionated ktlint_official rules (multiline-expression-wrapping, string-template-indent): they force
# churn on chained Spring/Redis calls and raw strings without improving readability.
ktlint_standard_multiline-expression-wrapping = disabled
ktlint_standard_string-template-indent = disabled

[*.{yml,yaml,json,md}]
indent_size = 2
